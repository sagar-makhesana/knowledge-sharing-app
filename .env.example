# Copy to .env.local (never commit .env.local) and fill in.

# Storage backend: "supabase" or "json". Leave unset to use Supabase when the two
# variables below are set, and the local JSON file otherwise.
KNOWLEDGE_STORAGE=supabase

# Supabase dashboard -> project home (Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Settings -> API Keys -> Secret keys (starts with sb_secret_).
# Server-side only: this key bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# JSON storage only: where the data file lives (default data/knowledge.json).
# KNOWLEDGE_DATA_FILE=data/knowledge.json
